{
  "name": "@yarunoka/builder",
  "version": "0.1.1",
  "description": "Yarunoka schedule definition DSL — headless schedule editor foundation for TypeScript",
  "keywords": [
    "yarunoka",
    "schedule",
    "dsl",
    "editor",
    "headless",
    "form"
  ],
  "homepage": "https://github.com/yarunoka-dev/ts-builder",
  "bugs": "https://github.com/yarunoka-dev/ts-builder/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yarunoka-dev/ts-builder.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:check": "node tools/docgen/generate.ts --check",
    "docs:generate": "node tools/docgen/generate.ts",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "prepack": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@yarunoka/core": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@yarunoka/core": "^0.3.0",
    "typescript": "^7.0.2"
  }
}
